{
  "name": "@event-commerce/cloud-api",
  "version": "0.1.0",
  "private": true,
  "files": ["dist", "migrations", "scripts", "db.js"],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "db:migrate": "node scripts/migrate.mjs",
    "supabase:check": "node db.js",
    "backup-restore-evidence": "node scripts/backup-restore-evidence.mjs",
    "recovery:seed-representative": "node scripts/seed-recovery-representative.mjs",
    "cloud-convergence:snapshot": "node scripts/cloud-convergence-snapshot.mjs",
    "edge-credential": "node scripts/manage-edge-credential.mjs",
    "operator-auth": "node scripts/manage-operator-auth.mjs",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@event-commerce/contracts": "workspace:*",
    "@event-commerce/domain": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@supabase/supabase-js": "^2.0.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.2",
    "supertest": "7.1.1"
  }
}
