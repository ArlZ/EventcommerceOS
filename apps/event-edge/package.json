{
  "name": "@event-commerce/event-edge",
  "version": "0.1.0",
  "private": true,
  "files": ["dist", "migrations", "scripts"],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "db:migrate": "node scripts/migrate.mjs",
    "pos-device": "node scripts/manage-pos-device.mjs",
    "pos-menu": "node scripts/manage-pos-menu.mjs",
    "lint": "eslint src test --max-warnings=0 --rule '@typescript-eslint/consistent-type-imports: off'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@event-commerce/contracts": "workspace:*",
    "@event-commerce/domain": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.2",
    "supertest": "7.1.1"
  }
}
