# Local development only. Do not use these credentials in production.
DATABASE_URL=postgresql://event_commerce:localdev_only@localhost:5432/event_commerce_cloud
EDGE_DATABASE_URL=postgresql://event_commerce:localdev_only@localhost:5433/event_commerce_edge
DATABASE_CONNECTION_TIMEOUT_MS=5000
EDGE_DATABASE_CONNECTION_TIMEOUT_MS=3000

# Exact 40-character lowercase Git commit deployed to this Cloud/Event Edge runtime.
# Required by controlled-pilot preflight and intentionally non-secret.
RELEASE_COMMIT=

# Cloud HTTP hard bounds / abuse protection.
# Production must explicitly choose single_instance_pilot or upstream_distributed.
ABUSE_DEPLOYMENT_MODE=single_instance_pilot
TRUST_PROXY_HOPS=0
HTTP_JSON_BODY_LIMIT_BYTES=1048576
HTTP_URLENCODED_BODY_LIMIT_BYTES=65536
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_HEADERS_COUNT=100

ABUSE_LIMIT_EDGE_SYNC_PER_MINUTE=1200
ABUSE_BURST_EDGE_SYNC=120
ABUSE_MAX_IN_FLIGHT_EDGE_SYNC=64
ABUSE_LIMIT_EDGE_PAYMENT_PER_MINUTE=3000
ABUSE_BURST_EDGE_PAYMENT=300
ABUSE_MAX_IN_FLIGHT_EDGE_PAYMENT=128
ABUSE_LIMIT_PROVIDER_CALLBACK_PER_MINUTE=1200
ABUSE_BURST_PROVIDER_CALLBACK=200
ABUSE_MAX_IN_FLIGHT_PROVIDER_CALLBACK=128
ABUSE_LIMIT_OPERATOR_READ_PER_MINUTE=600
ABUSE_BURST_OPERATOR_READ=60
ABUSE_MAX_IN_FLIGHT_OPERATOR_READ=128
ABUSE_LIMIT_OPERATOR_MUTATION_PER_MINUTE=120
ABUSE_BURST_OPERATOR_MUTATION=30
ABUSE_MAX_IN_FLIGHT_OPERATOR_MUTATION=32
ABUSE_LIMIT_PUBLIC_PER_MINUTE=120
ABUSE_BURST_PUBLIC=30
ABUSE_MAX_IN_FLIGHT_PUBLIC=64
ABUSE_MAX_BUCKETS=20000

# Set only when a reviewed upstream proxy/WAF/API gateway supplies distributed source limiting.
ABUSE_UPSTREAM_CONFIRMED=false

# Event Edge LAN-facing hard bounds / device abuse protection.
EDGE_HTTP_JSON_BODY_LIMIT_BYTES=1048576
EDGE_HTTP_URLENCODED_BODY_LIMIT_BYTES=65536
EDGE_HTTP_REQUEST_TIMEOUT_MS=15000
EDGE_HTTP_HEADERS_TIMEOUT_MS=5000
EDGE_HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
EDGE_HTTP_MAX_HEADERS_COUNT=100

EDGE_ABUSE_LIMIT_DEVICE_SYNC_PER_MINUTE=1800
EDGE_ABUSE_BURST_DEVICE_SYNC=180
EDGE_ABUSE_MAX_IN_FLIGHT_DEVICE_SYNC=64
EDGE_ABUSE_LIMIT_DEVICE_PAYMENT_PER_MINUTE=1200
EDGE_ABUSE_BURST_DEVICE_PAYMENT=120
EDGE_ABUSE_MAX_IN_FLIGHT_DEVICE_PAYMENT=192
EDGE_ABUSE_LIMIT_LOCAL_OTHER_PER_MINUTE=300
EDGE_ABUSE_BURST_LOCAL_OTHER=60
EDGE_ABUSE_MAX_IN_FLIGHT_LOCAL_OTHER=64
EDGE_ABUSE_MAX_BUCKETS=10000
