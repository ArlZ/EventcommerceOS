# Copy to .env on the venue-local Event Edge machine. Never commit .env.

# Exact merged release deployed to the venue Edge.
RELEASE_COMMIT=

# Cloud API is the only WAN destination Event Edge should need.
CLOUD_API_URL=https://api-event.nairobuy.com

# Venue-local identity. Provision this exact ID in Cloud before first start.
EDGE_ID=pilot-edge-01

# Secrets. Generate strong random URL-safe values. Do not paste them into chat or commit them.
EDGE_CLOUD_SYNC_TOKEN=
EDGE_LOCAL_ADMIN_TOKEN=
EDGE_POSTGRES_PASSWORD=

# LAN binding. Keep 3002 unless the venue network requires a different host port.
EDGE_BIND_ADDRESS=0.0.0.0
EDGE_PORT=3002

# Event Commerce OS Pilot organisation/event configuration (non-secret IDs).
PILOT_EVENT_ID=22d54497-de31-41cf-bd02-230e04f8a31d
PILOT_SALES_LOCATION_ID=a206a597-fd83-4153-9eea-36989fab7d9d
PILOT_INVENTORY_LOCATION_ID=9089795d-9373-410b-9895-92ffc6b0017b
PILOT_SKU_ID=0fee5ce5-f08a-44ba-86f0-da2d41b681da
PILOT_OPERATOR_ACTOR_ID=32b43332-4bae-40bd-b2b7-7d26e0c44bd0

# These timestamps assume the synthetic pilot event is moved to Aug 26-27 before Edge bootstrap.
PILOT_EVENT_END_AT=2026-08-27T02:00:00+03:00
PILOT_OPENING_STOCK_OCCURRED_AT=2026-08-26T17:00:00+03:00
PILOT_OPENING_STOCK_BASE=100

PILOT_INVENTORY_LOCATION_NAME=Pilot Store
PILOT_SKU_NAME=500 ml Bottle
PILOT_SKU_CATEGORY=Beverage
PILOT_SKU_BASE_UNIT=bottle
