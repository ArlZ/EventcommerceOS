# Hostinger managed Node.js Web App: Cloud API
# Add these in hPanel deployment environment variables. Never commit real secrets.
NODE_ENV=production
PORT=3000

# Public HTTPS origin of the separately deployed Event Control Web app.
CONTROL_WEB_ORIGIN=https://event.nairobuy.com

# External PostgreSQL connection string. The live managed pilot uses the dedicated
# Event Commerce OS Supabase PostgreSQL direct endpoint with TLS. Keep credentials
# only in Hostinger/provider secret stores.
DATABASE_URL=postgresql://replace-user:replace-password@replace-host:5432/replace-database?sslmode=require
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Operator browser authentication uses Supabase Auth for password + email OTP proof.
# The publishable key is intentionally not a service-role secret. Use the active
# project publishable key from Supabase and never place a service-role key here.
SUPABASE_AUTH_URL=https://replace-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Pilot abuse-protection mode. Validate Hostinger proxy behavior before field use.
ABUSE_DEPLOYMENT_MODE=single_instance_pilot
ABUSE_UPSTREAM_CONFIRMED=false
TRUST_PROXY_HOPS=1

# Pilot 1 remains Safaricom sandbox-only.
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CALLBACK_URL=https://api-event.nairobuy.com/payments/providers/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_TIMEOUT_MS=10000
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORT_CODE=
MPESA_PASSKEY=

# Release identity is normally derived from the checked-out Git commit and baked
# into the Cloud dist output automatically. Only set this fallback when the managed
# build source genuinely has no Git metadata; it must be the exact full Git SHA.
RELEASE_COMMIT=
