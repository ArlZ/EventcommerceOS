# Hostinger managed Node.js Web App: Event Control Web
# Add these in hPanel deployment environment variables.
NODE_ENV=production
PORT=3000

# This value is consumed by Next.js at build time and must be the canonical
# public HTTPS origin of the separately deployed Cloud API app.
NEXT_PUBLIC_CLOUD_API_URL=https://api.pilot.example.com

# Optional release identity for health output. Set this to the deployed full Git SHA
# when promoting a controlled candidate. Hostinger does not populate it automatically.
RELEASE_COMMIT=
