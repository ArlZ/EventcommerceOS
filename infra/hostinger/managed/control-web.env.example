# Hostinger managed static Event Control Web
# Add these in hPanel deployment environment variables.
NODE_ENV=production

# This value is consumed by Next.js at build time and must be the canonical
# public HTTPS origin of the separately deployed Cloud API app.
NEXT_PUBLIC_CLOUD_API_URL=https://api-event.nairobuy.com

# Release identity is normally derived from the checked-out Git commit at build
# time and baked into the exported health response automatically. Only set this
# fallback when the managed build source genuinely has no Git metadata; it must
# be the exact full Git SHA.
RELEASE_COMMIT=
