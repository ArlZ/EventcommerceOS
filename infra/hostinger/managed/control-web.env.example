# Hostinger managed static Event Control Web
# Add these in hPanel deployment environment variables.
NODE_ENV=production

# This value is consumed by Next.js at build time and must be the canonical
# public HTTPS origin of the separately deployed Cloud API app.
NEXT_PUBLIC_CLOUD_API_URL=https://api-event.nairobuy.com

# Optional build-time release identity for the exported health response.
RELEASE_COMMIT=
