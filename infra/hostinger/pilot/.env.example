# Exact release identity. Replace with the full lowercase 40-character Git SHA being deployed.
RELEASE_COMMIT=replace-with-full-40-character-lowercase-git-sha

# Point both A records to the Hostinger VPS public IP before deployment.
API_DOMAIN=api.pilot.example.com
CONTROL_DOMAIN=control.pilot.example.com

# Hostinger's Traefik Docker Catalog project creates this shared network by default.
TRAEFIK_NETWORK=traefik-proxy

# Generate with: openssl rand -hex 32
# The deployment script requires exactly 64 lowercase hex characters so the value is URL-safe.
POSTGRES_PASSWORD=replace-with-64-lowercase-hex-characters

# Pilot 1 is sandbox-only. Leave these empty until the Safaricom sandbox matrix is ready.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORT_CODE=
MPESA_PASSKEY=

# Set to 1 only for infrastructure bootstrap before public DNS/TLS is ready.
# A skipped HTTPS smoke is not release or field evidence.
HOSTINGER_SKIP_HTTPS_SMOKE=0

# Optional backup location on the VPS. Keep outside the Git checkout.
HOSTINGER_BACKUP_DIR=/opt/event-commerce/backups
