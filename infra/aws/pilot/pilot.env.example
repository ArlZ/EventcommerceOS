# Non-secret deployment inputs only.
# Copy to pilot.env locally; never add real credentials to this file.

AWS_REGION=af-south-1
STACK_NAME=event-commerce-pilot

# Exact validated lowercase 40-character Git SHA.
RELEASE_COMMIT=

# DNS names controlled by the pilot operator.
API_DOMAIN=
CONTROL_DOMAIN=

# ACM certificate in af-south-1 covering API_DOMAIN and CONTROL_DOMAIN.
CERTIFICATE_ARN=

# Keep 0 until images are pushed and Cloud migrations have succeeded.
DESIRED_COUNT=0

# Confirm this class is available in af-south-1 for the account.
DATABASE_INSTANCE_CLASS=db.t4g.micro

# Optional exact PostgreSQL engine version. Blank uses the regional RDS default.
DATABASE_ENGINE_VERSION=
