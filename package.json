{
  "name": "event-commerce-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,mjs}\" \"packages/**/*.{ts,tsx}\" \"scripts/*.mjs\" eslint.config.mjs",
    "arch:check": "node scripts/check-architecture.mjs",
    "security:sca": "node scripts/sca-evidence.mjs",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm test && pnpm format:check && pnpm arch:check"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@types/node": "22.15.29",
    "eslint": "9.28.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.0",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "overrides": {
      "glob@10.4.5": "10.5.0",
      "picomatch@4.0.1": "4.0.5",
      "postcss@8.4.31": "8.5.18",
      "sharp@0.34.5": "0.35.0",
      "tmp@0.0.33": "0.2.6"
    }
  }
}
