    "format:check": "prettier --check .",
    "arch:check": "node scripts/check-architecture.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@types/node": "22.15.29",
    "eslint": "9.28.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.0",
    "vitest": "3.2.1"
  }
}
